{
  "name": "etapa3-crawling-extracao",
  "version": "1.0.0",
  "description": "Extrai, baixa e unifica arquivos de uma pagina alvo, expondo o resultado via HTTP.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
